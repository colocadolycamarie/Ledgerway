# --- Database (used by packages/db and apps/api) ---------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/ledgerway

# --- API server (apps/api) --------------------------------------------------
NODE_ENV=development
PORT=3001
CLERK_SECRET_KEY=

# --- Web app (apps/web) -----------------------------------------------------
PORT=5173
BASE_PATH=/
VITE_CLERK_PUBLISHABLE_KEY=
# Only set this when the API is deployed separately from the web app (e.g.
# web on Vercel, API on Railway/Render/Fly). Leave unset for same-origin
# local dev, where requests to /api are same-origin already.
VITE_API_BASE_URL=
# Only needed in production behind a Clerk proxy (see apps/api/src/middleware/clerk-proxy.ts).
VITE_CLERK_PROXY_URL=
